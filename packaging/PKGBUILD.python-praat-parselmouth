# Maintainer: Yakuda <yakuda-stack@users.noreply.github.com>
# Praat as a Python library. Not yet in the AUR, so it ships alongside
# dream-voicetraining. Building compiles the bundled Praat sources and
# takes a few minutes.
pkgname=python-praat-parselmouth
_name=praat-parselmouth
pkgver=0.4.7
pkgrel=1
pkgdesc="Praat in Python, the Pythonic way"
arch=('x86_64')
url="https://github.com/YannickJadoul/Parselmouth"
license=('GPL-3.0-or-later')
depends=('python' 'python-numpy' 'gcc-libs')
makedepends=('python-build' 'python-installer' 'python-setuptools'
             'python-wheel' 'pybind11' 'cmake')
source=("https://files.pythonhosted.org/packages/source/${_name::1}/$_name/${_name//-/_}-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/${_name//-/_}-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/${_name//-/_}-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
